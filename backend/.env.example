# FarmNexus Backend Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Government of India data.gov.in API Key (AGMARKNET Daily Mandi Prices)
# Obtain your free key from: https://data.gov.in/user/register
# Dataset: Current Daily Price of Various Commodities from various Mandis (AGMARKNET)
# API Endpoint Resource: 9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmnexus
# Alternatively, discrete parameters:
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=farmnexus

# Cache TTL (in minutes) to prevent redundant upstream API queries
CACHE_TTL_MINUTES=30

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

