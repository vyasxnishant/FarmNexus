# =================================================================
# FARMNEXUS BACKEND CONFIGURATION (.env)
# =================================================================

PORT=5000
NODE_ENV=development
JWT_SECRET=farmnexus_secure_jwt_secret_change_in_production_2026
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection URL (Optional - in-memory data store is active by default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmnexus

# =================================================================
# PAYMENT GATEWAY: RAZORPAY / INDIAN UPI INTEGRATION
# =================================================================
# Obtain these credentials from the Razorpay Dashboard (https://dashboard.razorpay.com/app/keys)
# 1. RAZORPAY_KEY_ID: Public API Key (e.g. rzp_test_... or rzp_live_...)
# 2. RAZORPAY_KEY_SECRET: Private API Secret (STRICTLY KEPT ON SERVER - NEVER EXPOSE TO FRONTEND)
# 3. RAZORPAY_WEBHOOK_SECRET: Webhook Signature Secret (from Razorpay Webhooks settings)

RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# =================================================================
# EXTERNAL GOVERNMENT AGRI-DATA APIS (Optional)
# =================================================================
# Obtain a free 56-character API key from https://data.gov.in
DATA_GOV_IN_API_KEY=
AGMARKNET_API_KEY=
ENAM_API_KEY=
WEATHER_API_KEY=
