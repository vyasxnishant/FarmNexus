# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmnexus

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# External Agricultural & Weather API Keys
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key
AGMARKNET_API_KEY=your_agmarknet_api_key
ENAM_API_KEY=your_enam_api_key
WEATHER_API_KEY=your_weather_api_key

# Payment Gateway Secret Credentials
PAYMENT_SECRET_KEY=your_payment_secret_key
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret
